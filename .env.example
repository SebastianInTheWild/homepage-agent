# Nginx Proxy Manager
NPM_URL=http://192.168.x.x:81
NPM_USER=
NPM_PASSWORD=

# Technitium DNS
TECHNITIUM_URL=http://192.168.x.x:5380
TECHNITIUM_TOKEN=
# Mehrere Zonen kommagetrennt, leer = alle Zonen automatisch abfragen
TECHNITIUM_ZONES=home.lan,iot.lan

# Proxmox (optional, Rolle PVEAuditor)
PROXMOX_URL=https://192.168.x.x:8006
PROXMOX_TOKEN_ID=user@pve!homepage-agent
PROXMOX_TOKEN_SECRET=

# Homepage-Config (Pfad oder SSH-Ziel)
HOMEPAGE_CONFIG=/pfad/zu/homepage/config
# Ordner für Status, Backups und Löschsicherungen des Agenten
DATA_PATH=/pfad/zu/homepage-agent/data

# Slack (Socket Mode, keine öffentliche URL nötig)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C0123456789

# Zeitplan (Cron-Syntax), Standard: täglich 08:00
CHECK_SCHEDULE=0 8 * * *

# IP des Docker-Hosts (für Links auf Container mit Ports)
DOCKER_HOST_IP=192.168.x.x
# Kommagetrennt, Platzhalter erlaubt (z. B. shelly*,printer)
IGNORE=
# Gruppe für Vorschläge, wenn keine passende erkannt wird
DEFAULT_GROUP=

# Portainer (optional): neue Dienste als Docker-Labels am Container statt in services.yaml
PORTAINER_URL=https://192.168.x.x:9443
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=3

# Woraus Vorschläge entstehen (kommagetrennt: npm,dns,docker,proxmox). Standard: nur npm.
# DNS, Docker und Proxmox werden immer zum Anreichern und für veraltete Einträge genutzt.
CANDIDATE_SOURCES=npm
